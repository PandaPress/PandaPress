{layout '../parts/layout.latte'} {block content}

<main class="app-main">
  <div class="p-4">
    <h3>
      <a
        role="button"
        class="btn btn-primary"
        href="/admin/posts/compose?type=page"
      >
        Compose
      </a>
    </h3>
  </div>
  <div class="p-4">
    <table class="table w-100">
      <thead class="w-100">
        <tr>
          <th scope="col"><h4>Status</h4></th>
          <th scope="col"><h4>Category</h4></th>
          <th scope="col"><h4>Title</h4></th>
          <th scope="col"><h4>Tags</h4></th>
          <th scope="col"><h4>Date</h4></th>
          <th scope="col"><h4>Actions</h4></th>
        </tr>
      </thead>
      <tbody n:if="$posts" class="w-100">
        <tr n:foreach="$posts as $post">
          <td
            class="w-auto fw-bold {php echo $post['status'] === 'published' ? 'text-success' : 'text-secondary';}"
          >
            {$post['status']}
          </td>
          <td class="w-auto">
            <a
              href='{php echo "/admin/category/" . $post["category"]["slug"] ; }'
              target="_blank"
            >
              {$post['category']['title']}
            </a>
          </td>
          <td class="w-auto">
            <a href='{php echo "/post/" . $post["slug"] ; }' target="_blank">
              {$post['title']}
            </a>
          </td>
          <td class="w-auto">
            {foreach $post['tags'] as $tag}
            <span class="badge rounded-pill text-bg-primary">
              <a
                href='{php echo "/admin/posts/tags/" . $tag ; }'
                class="text-white"
              >
                {$tag}
              </a>
            </span>
            {/foreach}
          </td>

          <th scope="row" class="w-auto">
            {php echo date('m/d/Y', $post['created_at']);}
          </th>
          <td class="d-flex gap-2">
            <a
              href="/admin/posts/update/{$post['_id']}"
              role="button"
              class="btn btn-warning btn-sm"
              >Update</a
            >
            <form method="post" action="/admin/posts/delete">
              <input
                type="hidden"
                name="_id"
                value="{php echo $post['_id'];}"
              />
              <button type="submit" class="btn btn-danger btn-sm">
                Delete
              </button>
            </form>
          </td>
        </tr>
      </tbody>
    </table>
  </div>
</main>

{/block}
