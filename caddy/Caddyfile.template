{SITE_ADDRESS} {
    encode zstd gzip
    root * /var/www/html/public
    php_fastcgi php:9000
    file_server

    # Add basic logging
    log access {
        output file /var/log/caddy/access.log
        level WARN
    }

    log error {
        output file /var/log/caddy/error.log
        level ERROR
    }
}